# ====================================================================
# Git Ignore Configuration for Tank War (Java / VS Code Project)
# ====================================================================

# --- Java Compiled Bytecode & Logs ---
*.class
*.log
*.ctxt
hs_err_pid*
replay_pid*

# --- Package & Archive Files ---
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Compilation & Build Output Directories ---
bin/
build/
out/
target/
.gradle/

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
.history/
.ionide/

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr

# --- Eclipse IDE ---
.metadata
.classpath
.project
.settings/
local.properties
.loadpath
.recommenders

# --- NetBeans IDE ---
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- Editor Backup & Swap Files ---
*.swp
*.swo
*~
*.bak
*.orig
*.patch
